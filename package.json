{
  "name": "findesk",
  "private": true,
  "license": "MIT",
  "author": "Mujahidin (https://mujahidin.my.id)",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:dev": "NODE_ENV=development vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "db:check": "supabase/scratch/run.sh",
    "db:types": "supabase/scratch/run.sh types"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/vue-query": "^5.104.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "pnpm": "12.4.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
