# Supabase project the app talks to. Both values are public (the publishable
# key is safe in the browser, RLS is what protects the data).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Vercel Cron keep-alive (Vercel generates this on the project settings page)
CRON_SECRET=

# Turnstile site key (public); the secret goes in Supabase Auth settings, never here.
VITE_TURNSTILE_SITE_KEY=

# --- Supabase CLI (db push, functions deploy, config push); never prefixed VITE_, never shipped to the browser ---
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# --- Read by supabase/config.toml on `supabase config push` ---
# Resend SMTP password (Auth emails)
RESEND_API_KEY=
# Turnstile secret key (pair of VITE_TURNSTILE_SITE_KEY)
SUPABASE_AUTH_CAPTCHA_SECRET=
# Google sign-in (optional)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Edge Function secrets (`supabase secrets set --env-file .env.local`) ---
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase itself.
SEED_ADMIN_SECRET=
